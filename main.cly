LOG $LOGINFO
define code named NicCentFramework:WaitKit:WaitTimeMain with Python
|import ColyPythonSync
|import sys
|import time
|argv=sys.argv
|if not ColyPythonSync.InitColySyncService(argv) :
|    print("Can not link to Server")
|    exit()
|WaitTime=ColyPythonSync.ReadColyVar("NicCentFramework:WaitKit:WaitTime").data
