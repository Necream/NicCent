# ASCII Kit
print Initializing NiCentFramework Environment...(ASCIIKit)
define privatecode named NicCentFramework:ASCIIKit:InitCode with Python
|import ColyPythonSync
|import sys
|argv=sys.argv
|if not ColyPythonSync.InitColySyncService(argv):
|    exit()
|for i in range(128):
|    ColyPythonSync.ColySyncString("ASCII["+str(i)+"]",str(chr(i)))
use NicCentFramework:ASCIIKit:InitCode
define var named $ with $ASCII[36]
define var named NULL with $ASCII[0]
# exit

