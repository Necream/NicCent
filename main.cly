|time.sleep(WaitTime)
define function named WAITTIME with NicCentFramework:WaitKit:WaitTimeMain NicCentFramework:WaitKit:WaitTime
define code named NicCentFramework:WaitKit:WaitVarMain with Coly
|define privatevar named Command with define privatevar named initial with $ASCII[36] $NicCentFramework:WaitKit:WaitVarName
|do $Command
|define privatevar named Command with define privatevar named now with $ASCII[36] $NicCentFramework:WaitKit:WaitVarName
|define position named loop
|do $Command
|if $now $initial jump loop
