# Logger
print Initializing NiCentFramework Environment...(Logger)
define var named NicCentFramework:Logger:OutputReady with false
define var named NicCentFramework:Logger:Content with NULL
define privatecode named NicCentFramework:Logger:Main with Python
|import ColyPythonSync
|import time
|from datetime import datetime
|import sys
|argv=sys.argv
|if not ColyPythonSync.InitColySyncService(argv) :
|    print("Can not link to Server")
|    exit()
|while True:
|    if ColyPythonSync.ReadColyVar("NicCent:MainCloseSign").data == "true":
|        exit()
|    if ColyPythonSync.ReadColyVar("NicCentFramework:Logger:OutputReady").data == "true":
|        print("[",datetime.now(),"] ",ColyPythonSync.ReadColyVar("NicCentFramework:Logger:Content"),sep='',flush=True)
|        ColyPythonSync.RegColyVar("NicCentFramework:Logger:OutputReady")
|    time.sleep(0.1)
define var named OnlyCompile with true
use NicCentFramework:Logger:Main
define var named OnlyCompile with false
# use NicCentFramework:Logger:Main
usewithoutwait NicCentFramework:Logger:Main
define code named NicCentFramework:Logger:CallCode with Coly
|define position named loop
|if $NicCentFramework:Logger:OutputReady $true jump loop
|define var named NicCentFramework:Logger:OutputReady with true
|define position named loop
|if $NicCentFramework:Logger:OutputReady $true jump loop
define function named LOG with NicCentFramework:Logger:CallCode NicCentFramework:Logger:Content

