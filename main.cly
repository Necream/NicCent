# ExtensionsLoader
define var named LOGINFO with [ NicCentFramework ] Initializing NiCentFramework Environment...(ExtensionsLoader)
LOG $LOGINFO
# define var named C++:compilerun with cl /nologo /std:c++20 /I"C:\Coly\VariableSyncLib" /utf-8 /EHsc $$  /Fe:^.exe
define code named ExtensionsLoader with C++
|#include <iostream>
|#include <queue>
|#include <vector>
|#include <string>
|#include <filesystem>
|#include <fstream>
|#include <ColyCppSync.hpp>
|#include <GXPass.hpp>
|#include <Windows.h>
|using namespace std;
|namespace fs = std::filesystem;
|static string ReadFirstLine(const string& path) {
|    ifstream in(path);
|    string line;
|    if (in && getline(in, line)) {
|        if (!line.empty() && line.back() == '\r') {
|            line.pop_back();
|        }
|        return line;
|    }
|    return "";
|}
|static bool WriteTextFile(const string& path, const string& content) {
|    ofstream out(path, ios::trunc);
|    if (!out) {
|        return false;
|    }
|    out << content;
|    return out.good();
|}
|int main(int argc, char* argv[]) {
|    InitColySyncService();
|    const string extensionsPath = "C:\\NicCent\\Extensions";
|    const string hashPath = extensionsPath + "\\ExtensionsListHash.txt";
|    const string loadOrderPath = extensionsPath + "\\LoadOrder.txt";
|    vector<string> extensionPaths;
|    for (const auto& entry : fs::directory_iterator(extensionsPath)) {
|        if (entry.path().extension() == ".etipack") {
|            cout << entry.path().filename().string() << endl;
|            extensionPaths.push_back(entry.path().string());
|        }
|    }
|    string OriginHash;
|    for (const auto& extPath : extensionPaths) {
|        OriginHash += extPath;
|    }
|    string nowHash = GXPass::fullsafe(OriginHash);
|    string lastHash = ReadFirstLine(hashPath);
|    if (nowHash != lastHash) {
|        FILE *stream=fopen("C:\\NicCent\\Extensions\\ExtensionsListHash.txt", "w");
|        if(stream!=NULL){
|            fputs(nowHash.c_str(), stream);
|            fclose(stream);
|        }else{
|            cout << "Failed to write hash to file." << endl;
|            RegColyVar(ExtensionListHashWriteStatus);
|            ExtensionListHashWriteStatus = "fail";
|            return 1;
|        }
|        cout << "Found " << extensionPaths.size() << " extensions." << endl;
|        vector<string> loadedPaths;
|        bool anyFailed = false;
|        for (const auto& extPath : extensionPaths) {
|            cout << "Loading extension: " << extPath << endl;
|            RegColyVar(ExtensionPath);
|            ExtensionPath = extPath;
|            RegColyVar(ExtensionLoadStatus);
|            ExtensionLoadStatus = "import";
|            do {
|                ReadColyVar(ExtensionLoadStatus); // "processing"
|                if (ExtensionLoadStatus.data == "success") {
|                    cout << "Extension (" << extPath << ") loaded successfully." << endl;
|                    loadedPaths.push_back(extPath);
|                    break;
|                } else if (ExtensionLoadStatus.data == "fail") {
|                    cout << "Extension (" << extPath << ") loading failed." << endl;
|                    anyFailed = true;
|                    break;
|                }
|                Sleep(100);
|            } while (true);
|        }
|        if (anyFailed && loadedPaths.size() != extensionPaths.size()) {
|            cout << "Some extensions failed to load. Please check the log for more information." << endl;
|        }
|        string finalLoadOrder;
|        for (const auto& extPath : loadedPaths) {
|            finalLoadOrder += extPath;
|            finalLoadOrder += '\n';
|        }
|        if (!WriteTextFile(loadOrderPath, finalLoadOrder)) {
|            cout << "Failed to write load order to file." << endl;
|            RegColyVar(LoadOrderWriteStatus);
|            LoadOrderWriteStatus = "fail";
|            return 1;
|        }
|    } else {
|        ifstream in(loadOrderPath);
|        if (!in) {
|            cout << "Failed to read load order from file." << endl;
|            RegColyVar(LoadOrderReadStatus);
|            LoadOrderReadStatus = "fail";
|            return 1;
|        }
|        vector<string> loadOrder;
|        string line;
|        while (getline(in, line)) {
|            if (!line.empty() && line.back() == '\r') {
|                line.pop_back();
|            }
|            if (!line.empty()) {
|                loadOrder.push_back(line);
|            }
|        }
|        for (const auto& extPath : loadOrder) {
|            RegColyVar(ExtensionPath);
|            ExtensionPath = extPath;
|            RegColyVar(ExtensionLoadStatus);
|            ExtensionLoadStatus = "import";
|            do {
|                ReadColyVar(ExtensionLoadStatus); // "processing"
|                if (ExtensionLoadStatus.data == "success") {
|                    cout << "Extension (" << extPath << ") loaded successfully." << endl;
|                    break;
|                } else if (ExtensionLoadStatus.data == "fail") {
|                    cout << "Extension (" << extPath << ") loading failed." << endl;
|                    break;
|                }
|                Sleep(100);
|            } while (true);
|        }
|    }
|    RegColyVar(ExtensionsLoadComplete);
|    ExtensionsLoadComplete = "true";
|    return 0;
|}
define var named LOGINFO with [ ExtensionsLoader ] Initializing Environment...
LOG $LOGINFO
define var named ExtensionLoadStatus with $NULL
define var named ExtensionsLoadComplete with $NULL
define var named ExtensionPath with $NULL
define var named OnlyCompile with true
use ExtensionsLoader
define var named OnlyCompile with false
usewithoutwait ExtensionsLoader
define privatevar named import with import
define privatevar named fail with fail
define var named LoadOrderReadStatus with $NULL
define var named LoadOrderWriteStatus with $NULL
define var named ExtensionListHashWriteStatus with $NULL
define var named ExtensionListHashReadStatus with $NULL
define var named LOGINFO with [ ExtensionsLoader ] Loading Extensions...
LOG $LOGINFO
define position named loop
if $ExtensionLoadStatus $import print Importing extension: $ExtensionPath
if $ExtensionLoadStatus $import do import lib $ExtensionPath
WAITTIME 0.1
if $LoadOrderReadStatus $fail print Can not read LoadOrder.txt, about to exit.
if $LoadOrderReadStatus $fail define var named NicCent:MainCloseSign with true
if $LoadOrderReadStatus $fail exit
if $LoadOrderWriteStatus $fail print Can not write to LoadOrder.txt, about to exit.
if $LoadOrderWriteStatus $fail define var named NicCent:MainCloseSign with true
if $LoadOrderWriteStatus $fail exit
if $ExtensionListHashWriteStatus $fail print Can not write to ExtensionListHash.txt, about to exit.
if $ExtensionListHashWriteStatus $fail define var named NicCent:MainCloseSign with true
if $ExtensionListHashWriteStatus $fail exit
if $ExtensionListHashReadStatus $fail print Can not read ExtensionListHash.txt, about to exit.
if $ExtensionListHashReadStatus $fail define var named NicCent:MainCloseSign with true
if $ExtensionListHashReadStatus $fail exit
ifn $ExtensionsLoadComplete $true jump loop
define var named LOGINFO with [ ExtensionsLoader ] Loading Extensions Complete.
LOG $LOGINFO

### END
define privatevar named checkinfo with exit
define position named loop
print Input 'exit' to exit.
define var named inputinfo with $Input
ifn $inputinfo $checkinfo do $inputinfo
ifn $inputinfo $checkinfo jump loop
define var named NicCent:MainCloseSign with true